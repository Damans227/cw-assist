{
  "manifest_version": 3,
  "name": "ConnectWise support assist",
  "version": "1.0",
  "description": "Reads the open ticket and runs it past a local model \u2014 summary, what's outstanding, next diagnostic step.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://eu.myconnectwise.net/*",
    "https://10.1.3.21/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ConnectWise support assist",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://eu.myconnectwise.net/*"
      ],
      "js": [
        "grab.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://eu.myconnectwise.net/*"
      ],
      "js": [
        "watch-ticket.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "minimum_chrome_version": "114",
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  }
}