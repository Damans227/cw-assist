{
  "manifest_version": 3,
  "name": "ConnectWise support assist",
  "version": "1.1",
  "description": "Reads the open ConnectWise ticket and runs it past your own OpenAI-compatible model — summary, what's outstanding, and a drafted GitHub issue.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://*.myconnectwise.net/*",
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ConnectWise support assist",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.myconnectwise.net/*"
      ],
      "js": [
        "grab.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.myconnectwise.net/*"
      ],
      "js": [
        "watch-ticket.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "minimum_chrome_version": "114"
}
